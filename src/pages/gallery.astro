---
import Layout from "../layouts/Layout.astro";
import herEndlessSummer from "../assets/gallery/her-endless-summer.png";
import moonrise from "../assets/gallery/moonrise.png";

const artworks = [
  {
    title: "Her Endless Summer",
    image: herEndlessSummer,
    alt: "A painting of a red rose on an easel amid a vast garden of withered roses, with mist, garden arches, and a low sun beneath a cloudy sky.",
  },
  {
    title: "Moonrise",
    image: moonrise,
    alt: "A giant screen displaying a glowing golden moon rises from a stormy sea beside a rain-soaked coastal road and an illuminated hillside town.",
  },
];
const widestArtwork = Math.max(...artworks.map((artwork) => artwork.image.width));
---

<Layout title="Gallery - IQ404" description="A collection of images I've created with AI.">
  <div class="container gallery" style={`--gallery-width: ${widestArtwork}px;`}>
    <header class="page-header fade-in">
      <h1>Gallery</h1>
      <p>Images I've created with AI.</p>
    </header>

    {artworks.map((artwork) => (
      <figure
        class="artwork"
        style={`--artwork-width: ${artwork.image.width}px; --artwork-height: ${artwork.image.height}px;`}
      >
        <div
          class="artwork-frame"
          tabindex="0"
          role="region"
          aria-label={`${artwork.title}, original-size artwork`}
        >
          <img
            src={artwork.image.src}
            alt={artwork.alt}
            width={artwork.image.width}
            height={artwork.image.height}
            loading="eager"
            fetchpriority={artwork.image === herEndlessSummer ? "high" : "auto"}
            decoding="async"
            class="artwork-image"
          />
        </div>

        <figcaption class="artwork-caption">
          <div>
            <h2>{artwork.title}</h2>
            <p class="artwork-credit">Generated with ChatGPT Images 2.5.</p>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</Layout>

<script>
  const gallery = document.querySelector<HTMLElement>(".gallery");
  const artworkImages = Array.from(document.querySelectorAll<HTMLImageElement>(".artwork-image"))
    .map((image) => ({
      figure: image.closest<HTMLElement>(".artwork"),
      pixelWidth: Number(image.getAttribute("width")),
      pixelHeight: Number(image.getAttribute("height")),
    }));

  if (gallery && artworkImages.length > 0) {
    // HTML dimensions describe the PNG; CSS pixels can span multiple screen pixels.
    const widestImage = Math.max(...artworkImages.map((artwork) => artwork.pixelWidth));
    let resolutionQuery: MediaQueryList | undefined;

    const updatePixelSize = () => {
      const ratio = window.devicePixelRatio || 1;
      gallery.style.setProperty("--gallery-width", `${widestImage / ratio}px`);
      artworkImages.forEach((artwork) => {
        artwork.figure?.style.setProperty("--artwork-width", `${artwork.pixelWidth / ratio}px`);
        artwork.figure?.style.setProperty("--artwork-height", `${artwork.pixelHeight / ratio}px`);
      });

      // Re-arm when browser zoom or the monitor's display scaling changes.
      resolutionQuery?.removeEventListener("change", updatePixelSize);
      resolutionQuery = window.matchMedia(`(resolution: ${ratio}dppx)`);
      resolutionQuery.addEventListener("change", updatePixelSize);
    };

    updatePixelSize();
    window.addEventListener("resize", updatePixelSize);
  }
</script>

<style>
  .gallery {
    --artwork-mat: 12px;
    max-width: calc(var(--gallery-width) + var(--artwork-mat) + var(--artwork-mat) + 2px + 3rem);
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .artwork {
    width: calc(var(--artwork-width) + var(--artwork-mat) + var(--artwork-mat) + 2px);
    max-width: 100%;
  }

  .artwork + .artwork {
    margin-top: 4rem;
  }

  .artwork-frame {
    display: block;
    overflow-x: auto;
    padding: var(--artwork-mat);
    background: #101113;
    border: 1px solid #303035;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .artwork-frame:focus-visible {
    outline-offset: 6px;
  }

  .artwork-image {
    display: block;
    width: var(--artwork-width);
    height: var(--artwork-height);
    max-width: none;
  }

  .artwork-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: 1.75rem 0 0;
  }

  .artwork-caption h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #eeeae3;
  }

  .artwork-credit {
    margin-top: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .gallery {
      --artwork-mat: 5px;
      padding-bottom: 0;
    }

    .artwork-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 1.5rem;
    }
  }
</style>
