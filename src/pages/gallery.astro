---
import Layout from "../layouts/Layout.astro";
import herEndlessSummer from "../assets/gallery/her-endless-summer.png";
---

<Layout title="Gallery - IQ404" description="A collection of images I've created with AI.">
  <div class="container gallery">
    <header class="page-header fade-in">
      <h1>Gallery</h1>
      <p>Images I've created with AI.</p>
    </header>

    <figure class="artwork">
      <div
        class="artwork-frame"
        tabindex="0"
        role="region"
        aria-label="Her Endless Summer, original-size artwork"
      >
        <img
          src={herEndlessSummer.src}
          alt="A painting of a red rose on an easel amid a vast garden of withered roses, with mist, garden arches, and a low sun beneath a cloudy sky."
          width={herEndlessSummer.width}
          height={herEndlessSummer.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="artwork-image"
        />
      </div>

      <figcaption class="artwork-caption">
        <div>
          <h2>Her Endless Summer</h2>
          <p class="artwork-credit">Generated with ChatGPT Images 2.5.</p>
        </div>
      </figcaption>
    </figure>
  </div>
</Layout>

<script>
  const gallery = document.querySelector<HTMLElement>(".gallery");
  const artwork = document.querySelector<HTMLImageElement>(".artwork-image");

  if (gallery && artwork) {
    // HTML dimensions describe the PNG; CSS pixels can span multiple screen pixels.
    const pixelWidth = Number(artwork.getAttribute("width"));
    const pixelHeight = Number(artwork.getAttribute("height"));
    let resolutionQuery: MediaQueryList | undefined;

    const updatePixelSize = () => {
      const ratio = window.devicePixelRatio || 1;
      gallery.style.setProperty("--artwork-width", `${pixelWidth / ratio}px`);
      gallery.style.setProperty("--artwork-height", `${pixelHeight / ratio}px`);

      // Re-arm when browser zoom or the monitor's display scaling changes.
      resolutionQuery?.removeEventListener("change", updatePixelSize);
      resolutionQuery = window.matchMedia(`(resolution: ${ratio}dppx)`);
      resolutionQuery.addEventListener("change", updatePixelSize);
    };

    updatePixelSize();
    window.addEventListener("resize", updatePixelSize);
  }
</script>

<style>
  .gallery {
    --artwork-width: 1672px;
    --artwork-height: 941px;
    --artwork-mat: 12px;
    max-width: calc(var(--artwork-width) + var(--artwork-mat) + var(--artwork-mat) + 2px + 3rem);
    padding-bottom: 2rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-header h1 {
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .artwork-frame {
    display: block;
    overflow-x: auto;
    padding: var(--artwork-mat);
    background: #101113;
    border: 1px solid #303035;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }

  .artwork-frame:focus-visible {
    outline-offset: 6px;
  }

  .artwork-image {
    display: block;
    width: var(--artwork-width);
    height: var(--artwork-height);
    max-width: none;
  }

  .artwork-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: 1.75rem 0 0;
  }

  .artwork-caption h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #eeeae3;
  }

  .artwork-credit {
    margin-top: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .gallery {
      --artwork-mat: 5px;
      padding-bottom: 0;
    }

    .artwork-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
      padding-top: 1.5rem;
    }
  }
</style>
