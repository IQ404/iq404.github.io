---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Tennis - IQ404" description="My love of playing and watching tennis.">
  <div class="container">
    <header class="page-header fade-in">
      <h1>Tennis</h1>
    </header>

    <div class="prose fade-in">
      <p>
        I love tennis, and I'm also a huge fan of watching tennis matches. I started playing when I was around six and a half, and I currently play at a semi-pro level.
      </p>
      <p>
        Do get in touch if you love tennis too and happen to be nearby. (I'm not coaching, just enjoying the game.)
      </p>
      <p>
        P.S. The EZONE 100 is the best tennis racket ever.
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
</style>
